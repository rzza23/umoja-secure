{
  "name": "umoja-backend",
  "version": "0.1.0",
  "description": "Umoja Secure backend (server-blind messaging relay)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <27.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "migrate": "tsx scripts/migrate.ts",
    "sbom": "cyclonedx-npm --output-file sbom.json"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@fastify/rate-limit": "10.1.1",
    "@fastify/websocket": "10.0.1",
    "@noble/ed25519": "2.1.0",
    "fastify": "5.12.5",
    "pg": "8.12.0",
    "pino": "9.3.2",
    "uuid": "11.1.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/pg": "8.11.6",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "eslint": "9.7.0",
    "pino-pretty": "11.2.2",
    "tsx": "4.20.0",
    "typescript": "5.5.4",
    "vitest": "2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
